{
  "name": "@radarbase/app-kit",
  "version": "0.0.2",
  "description": "A plugin-based React Native library of widgets, components, and services for building configuration-driven health research apps",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "tsc && npm run copy-assets",
    "copy-assets": "mkdir -p lib/theme/icons && cp src/theme/icons/*.svg lib/theme/icons/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf lib",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --passWithNoTests",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json}\""
  },
  "keywords": [
    "react-native",
    "health",
    "research",
    "plugin",
    "widget",
    "sdui",
    "server-driven-ui",
    "configuration-driven",
    "library"
  ],
  "author": "RADAR-Base",
  "license": "MIT",
  "peerDependencies": {
    "@react-native-async-storage/async-storage": ">=1.0.0",
    "@react-native-firebase/analytics": ">=18.0.0",
    "@react-native-firebase/app": ">=18.0.0",
    "@react-native-firebase/messaging": ">=18.0.0",
    "@react-native-firebase/remote-config": ">=18.0.0",
    "@shopify/react-native-skia": ">=1.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.80.0",
    "react-native-keychain": ">=8.0.0",
    "react-native-reanimated": ">=3.0.0",
    "react-native-safe-area-context": ">=4.0.0",
    "react-native-svg": ">=13.0.0",
    "expo-audio": ">=0.3.0",
    "expo-web-browser": ">=14.0.0",
    "@kingstinct/react-native-healthkit": ">=7.0.0",
    "expo-camera": "~57.0.5"
  },
  "peerDependenciesMeta": {
    "@react-native-async-storage/async-storage": {
      "optional": true
    },
    "@react-native-firebase/analytics": {
      "optional": true
    },
    "@react-native-firebase/app": {
      "optional": true
    },
    "@react-native-firebase/messaging": {
      "optional": true
    },
    "@react-native-firebase/remote-config": {
      "optional": true
    },
    "react-native-keychain": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    },
    "@shopify/react-native-skia": {
      "optional": true
    },
    "expo-audio": {
      "optional": true
    },
    "expo-web-browser": {
      "optional": true
    },
    "@kingstinct/react-native-healthkit": {
      "optional": true
    },
    "expo-camera": {
      "optional": true
    }
  },
  "dependencies": {
    "js-yaml": "^4.3.2",
    "mitt": "3.0.1",
    "react-native-worklets": "^0.10.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.6.2",
    "@types/jest": "29.5.14",
    "@types/js-yaml": "4.0.9",
    "@types/react": "~19.2.4",
    "@types/react-native": "0.73.0",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-react-native": "4.1.0",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "lint-staged": "^15.5.2",
    "prettier": "3.4.2",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-test-renderer": "19.2.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "react-native",
    "testEnvironment": "node",
    "transform": {
      "^.+\\.(ts|tsx)$": "babel-jest"
    },
    "testMatch": [
      "**/__tests__/**/*.{ts,tsx}",
      "**/*.test.{ts,tsx}"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/index.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70
      }
    }
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "files": [
    "lib",
    "README.md"
  ]
}