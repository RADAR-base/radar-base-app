{
  "expo": {
    "name": "RADAR-Base Starter",
    "slug": "radar-base-starter",
    "version": "0.1.0",
    "scheme": "com.radarbase.starter",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "plugins": [
      "expo-audio"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.radarbase.starter",
      "scheme": "com.radarbase.starter",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "This app requires microphone access to record audio messages."
      }
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "package": "org.radarbase.starter",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "com.radarbase.starter",
              "host": "enrol"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro"
    }
  }
}