{
  "expo": {
    "name": "RADAR-Base Starter",
    "slug": "radar-base-starter",
    "version": "0.1.0",
    "scheme": "com.radarbase.starter",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-font",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "privacyManifestAggregationEnabled": false,
            "deploymentTarget": "16.4"
          }
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.radarbase.starter",
      "scheme": "com.radarbase.starter",
      "deploymentTarget": "16.4",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "package": "org.radarbase.starter",
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "com.radarbase.starter",
              "host": "enrol"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro"
    }
  }
}