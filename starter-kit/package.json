    "@react-native-firebase/app": "^23.2.2",
    "@react-native-firebase/messaging": "^23.2.2",
    "@react-native-firebase/remote-config": "^23.2.2",
    "@react-native/virtualized-lists": "^0.79.5",
    "expo": "~53.0.0",
    "expo-status-bar": "~2.2.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.5",
    "react-native-web": "0.20.0",
    "superstruct": "^0.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
