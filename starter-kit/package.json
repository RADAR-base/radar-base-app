{
  "name": "radar-base-starter-kit",
  "version": "0.0.1",
  "description": "Starter template for building a study app on top of @radarbase/app-kit. Clone, rename, drop in a config, ship.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@radarbase/app-kit": "file:..",
    "@react-native-async-storage/async-storage": "^1.24.0",
    "@react-native-firebase/app": "^23.2.2",
    "@shopify/react-native-skia": "v2.0.0-next.4",
    "expo": "~53.0.0",
    "expo-dev-client": "~5.2.4",
    "react": "19.0.0",
    "react-native": "0.79.5",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-svg": "15.11.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.0.10",
    "babel-preset-expo": "~13.0.0",
    "react-native-svg-transformer": "^1.5.3",
    "typescript": "~5.8.3"
  }
}
