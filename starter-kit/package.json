{
  "name": "radar-base-starter-kit",
  "version": "0.0.1",
  "description": "Starter template for building a study app on top of @radarbase/app-kit. Clone, rename, drop in a config, ship.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@radarbase/app-kit": "file:..",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/analytics": "^23.8.8",
    "@react-native-firebase/app": "^23.2.2",
    "@react-native-firebase/messaging": "^23.8.8",
    "@react-native-firebase/remote-config": "^23.8.8",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "^57.0.22",
    "expo-build-properties": "~57.0.17",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "superstruct": "^0.16.0",
    "webidl-conversions": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@types/react": "~19.2.10",
    "babel-preset-expo": "~57.0.0",
    "react-native-svg-transformer": "^1.5.3",
    "typescript": "~6.0.3"
