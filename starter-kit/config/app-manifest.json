{
  "appName": "RADAR Active App",
  "version": "1.0.0",
  "configSchemaVersion": "1",
  "clinicalTemplate": null,
  "theme": {
  },
  "header": {
    "title": "Hello",
    "subtitle": "Track your data and complete your daily tasks",
    "showName": true,
    "profileIcon": true,
    "showSettings": true
  },
  "tabs": [
    {
      "id": "tab_home",
      "label": "Home",
      "showLabel": true,
      "icon": "home",
      "viewPath": "views/home.json"
    },
    {
      "id": "tab_calendar",
      "label": "Calendar",
      "showLabel": true,  
      "icon": "calendar",
      "viewPath": "views/calendar.json"
    },
    {
      "id": "tab_profile",
      "label": "Profile",
      "showLabel": true,
      "icon": "person",
      "viewPath": "views/profile.json"
    },
    {
      "id": "tab_more",
      "label": "More",
      "showLabel": true,
      "icon": "grid",
      "viewPath": "views/coming-soon.json"
    }
  ],
  "secondaryViews": {
    "daily_questionnaire": "views/secondary/questionnaire.json",
    "inbox_history": "views/secondary/inbox-history.json"
  },
  "widgetsRegistry": [
    {
      "type": "CustomDemoNode",
      "module": "./CustomDemoNode"
    }
  ],
  "alerts": {
    "enabled": true,
    "rules": [
      {
        "id": "high_bp",
        "metric": "bloodPressureSystolic",
        "condition": "gt",
        "threshold": 140,
        "actions": [
          {
            "type": "ShowBanner",
            "severity": "warning",
            "message": "Blood pressure reading is above normal range"
          },
          {
            "type": "SendNotification",
            "title": "High blood pressure recorded",
            "body": "Your latest reading was above 140 mmHg."
          }
        ]
      },
      {
        "id": "missed_medication",
        "metric": "medicationAdherence",
        "condition": "lt",
        "threshold": 0.7,
        "windowDays": 7,
        "actions": [
          {
            "type": "ShowBanner",
            "severity": "info",
            "message": "Medication adherence has dropped below 70% this week"
          },
          {
            "type": "AddTask",
            "taskType": "MedicationReview",
            "title": "Review your medication schedule",
            "dueOffsetDays": 1
          }
        ]
      }
    ]
  },
  "roles": {
    "participant": "views/home.json"
  },
  "cms": {
    "articlesEndpoint": "https://cms.radar-base.org/articles",
    "cacheTTLMinutes": 60
  }
}