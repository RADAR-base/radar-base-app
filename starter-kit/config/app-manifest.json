{
  "appName": "RADAR Active App",
  "description": "Track your health data and complete your daily study tasks.",
  "version": "1.0.0",
  "configSchemaVersion": "1",
  "theme": {
    "brandColors": {
      "brand": "#1e3557",
      "accent": "#4dabf7",
      "background": "#EDF1F5"
    }
  },
  "header": {
    "title": "Welcome",
    "subtitle": "Track your data and complete your daily tasks",
    "showSettings": true,
    "showNotifications": true,
    "profileIcon": true,
    "settingsViewPath": "views/secondary/settings.json",
    "notificationsViewPath": "views/secondary/notifications.json"
  },
  "tabs": [
    { "id": "tab_home", "label": "Home", "icon": "home", "viewPath": "views/home.json" },
    { "id": "tab_calendar", "label": "Calendar", "icon": "calendar", "viewPath": "views/calendar.json" },
    { "id": "tab_profile", "label": "Profile", "icon": "person", "viewPath": "views/profile.json" }
  ],
  "secondaryViews": {
    "daily_questionnaire": "views/secondary/questionnaire.json",
    "inbox_history": "views/secondary/inbox-history.json"
  },
  "widgetsRegistry": [
    { "type": "CustomDemoNode", "module": "./CustomDemoNode" }
  ],
  "roles": {
    "participant": "views/home.json"
  },
  "auth": {
    "clientId": "aRMT",
    "clientSecret": "",
    "endpoint": "https://dev.radarbasedev.co.uk",
    "scopes": "SUBJECT.READ SUBJECT.UPDATE PROJECT.READ MEASUREMENT.CREATE offline_access",
    "audience": "res_ManagementPortal res_gateway res_AppServer",
    "redirectUri": "com.radarbase.starter://enrol",
    "authPath": "/hydra/oauth2/auth",
    "tokenPath": "/hydra/oauth2/token"
  }
}
