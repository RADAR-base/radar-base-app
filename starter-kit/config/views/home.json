{
  "blueprintVersion": "1",
  "root": {
    "id": "root_home",
    "type": "ViewNode",
    "isCanvas": true,
    "title": "Health Dashboard",
    "children": [
      {
        "id": "section_card_activity",
        "type": "CardSectionNode",
        "title": "My Activity",
        "layout": "grid",
        "children": [
          {
            "id": "card_check_in",
            "type": "StatCardNode",
            "statsType": "checkIn",
            "value": 12,
            "size": "small"
          },
          {
            "id": "card_current_streak",
            "type": "StatCardNode",
            "statsType": "currentStreak",
            "value": 4,
            "size": "large"
          },
          {
            "id": "card_longest_streak",
            "type": "StatCardNode",
            "statsType": "longestStreak",
            "value": 7,
            "size": "small"
          }        
        ]
      },
      {
        "id": "section_todo",
        "type": "SectionNode",
        "title": "To Do",
        "showSeeAll": true,
        "seeAllAction": "views/calendar.json",
        "children": [
          {
            "id": "todo_list",
            "type": "TaskListSectionNode",
            "variant": "multiCard",
            "filter": { "status": "incomplete" }
          }
        ]
      },
      {
        "id": "section_data_wheel",
        "type": "SectionNode",
        "title": "My Data",
        "layout": "horizontal",
        "children": [
          {
            "id": "wheel_steps",
            "type": "DataWheelCardNode",
            "size": "small",
            "title": "Steps Goal",
            "metric": "steps_goal_percent",
            "value": 5000,
            "target": 10000
          }
        ]
      },
      {
        "id": "section_data",
        "type": "SectionNode",
        "title": "My Data",
        "layout": "horizontal",
        "children": [
          {
            "id": "vitals_sleep",
            "type": "VitalsChartNode",
            "vitalType": "sleep_hours",
            "variant": "compact"
          },
          {
            "id": "vitals_steps",
            "type": "VitalsChartNode",
            "vitalType": "steps",
            "variant": "compact"
          },
          {
            "id": "vitals_stress",
            "type": "VitalsChartNode",
            "vitalType": "stress",
            "variant": "compact"
          }
        ]
      },
      {
        "id": "card_custom_demo",
        "type": "CardNode",
        "isCanvas": true,
        "children": [
          {
            "id": "custom_runtime_demo",
            "type": "CustomDemoNode",
            "title": "Runtime Registered Widget",
            "description": "Loaded via manifest widgetsRegistry"
          }
        ]
      }
    ]
  }
}
