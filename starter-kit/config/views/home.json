{
  "blueprintVersion": "1",
  "root": {
    "id": "root_home",
    "type": "ViewNode",
    "isCanvas": true,
    "title": "Health Dashboard",
    "children": [
      {
        "id": "section_card_activity",
        "type": "CardSectionNode",
        "title": "My Engagement",
        "layout": "grid",
        "children": [
          {
            "id": "card_active_days",
            "type": "StatCardNode",
            "statsType": "activeDays",
            "metric": "active_days",
            "size": "small"
          },
          {
            "id": "task_completed",
            "type": "DataWheelCardNode",
            "size": "small",
            "title": "Todays Tasks",
            "metric": "task_completed",
            "showTotal": true,
            "showOpenButton": false
          },
          {
            "id": "card_current_streak",
            "type": "StatCardNode",
            "statsType": "currentStreak",
            "size": "small"
          },
          {
            "id": "card_active_days2",
            "type": "StatCardNode",
            "statsType": "activeDays",
            "metric": "active_days",
            "size": "large"
          },
          {
            "id": "card_current_streak2",
            "type": "StatCardNode",
            "statsType": "longestStreak",
            "size": "large"
          }
        ]
      },
      {
        "id": "section_todo",
        "type": "SectionNode",
        "title": "To Do",
        "showSeeAll": true,
        "seeAllTab": "tab_calendar",
        "children": [
          {
            "id": "todo_list",
            "type": "TaskListSectionNode",
            "variant": "singleCard"
          }
        ]
      },
      {
        "id": "section_data_wheel",
        "type": "SectionNode",
        "title": "My Data",
        "layout": "vertical",
        "children": [
          {
            "id": "wheel_steps",
            "type": "DataWheelCardNode",
            "size": "large",
            "title": "Steps Goal",
            "metric": "steps_goal_percent",
            "value": 4000,
            "target": 10000
          },
          {
            "id": "graph_heart_rate",
            "type": "LineGraphCardNode",
            "title": "Heart Rate",
            "metric": "heart_rate",
            "unit": "bpm",
            "xAxis": "day",
            "values": [
              62, 64, 61, 68, 72, 88, 95, 84, 79, 74, 70, 76, 90, 102, 96, 85, 80, 77, 73, 69, 66,
              64, 63, 61
            ]
          },
          {
            "id": "bars_steps_small",
            "type": "BarChartCardNode",
            "size": "small",
            "title": "Steps",
            "metric": "steps_daily",
            "unit": "steps",
            "values": [62, 81, 74, 98, 112, 86, 62]
          },
          {
            "id": "bars_steps_large",
            "type": "BarChartCardNode",
            "size": "large",
            "title": "Average",
            "description": "Your daily steps across the last week.",
            "metric": "steps_daily",
            "unit": "steps",
            "values": [62, 81, 74, 9, 112, 86, 62]
          },
          {
            "id": "arc_readiness",
            "type": "ArcDataCardNode",
            "title": "Readiness",
            "metric": "readiness_score",
            "value": 82,
            "target": 100
          },
          {
            "id": "arc_resting_hr",
            "type": "ArcDataCardNode",
            "title": "Resting Heart Rate",
            "metric": "resting_hr",
            "value": 58,
            "target": 120,
            "reverse": true
          }
        ]
      },
      {
        "id": "section_data",
        "type": "SectionNode",
        "title": "My Data",
        "layout": "horizontal",
        "children": [
          {
            "id": "vitals_sleep",
            "type": "GraphDataNode",
            "graphType": "sleep_hours",
            "variant": "compact"
          },
          {
            "id": "vitals_steps",
            "type": "GraphDataNode",
            "graphType": "steps",
            "variant": "compact"
          },
          {
            "id": "vitals_stress",
            "type": "GraphDataNode",
            "graphType": "stress",
            "variant": "compact"
          }
        ]
      },
      {
        "id": "card_custom_demo",
        "type": "CardNode",
        "isCanvas": true,
        "children": [
          {
            "id": "custom_runtime_demo",
            "type": "CustomDemoNode",
            "title": "Runtime Registered Widget",
            "description": "Loaded via manifest widgetsRegistry"
          }
        ]
      }
    ]
  }
}
